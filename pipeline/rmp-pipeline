# /etc/cron.d/rmp-pipeline
# Raise My Presence — Outreach Send Automation
#
# Managed by RMP-2 deploy workflow. Edit canonical source in vault at:
#   Local-Presence-Optimization/src/pipeline/rmp-pipeline
# Never edit /etc/cron.d/rmp-pipeline directly on Tencent.
#
# Schedule (system local time = CST/UTC+8 — cron uses system local, NOT UTC):
#   UK  08:00 CST → 00:00 UTC → 01:00 BST             [PAUSED 2026-05-08 — RMP #26]
#   US  13:00 CST → 05:00 UTC → 01:00 EDT / 00:00 CDT
#   AU  22:00 CST → 14:00 UTC → 00:00 AEST (next day)  [PAUSED 2026-05-08 — RMP #26]
#
# NOTE on send-time strategy (discovered RMP #45, 2026-05-23):
# Pre-#45 comments claimed sends fire at 9 AM US local. Cron actually fires
# at 13:00 CST → 05:00 UTC → midnight / 01:00 US local. The #37 baseline at
# midnight delivery is 45.83% open — excellent. Whether to shift to 9 AM US
# local (change `0 13 * * *` → `0 21 * * *`) is logged as a deferred
# follow-up in open-gates.md ("Send-time strategy evaluation",
# trigger 2026-06-06 = ~2 weeks of additional engagement data).
#
# US-only focus locked RMP #26 (2026-05-08). UK + AU paused pending US
# extraction validation (cascade fix + first-sale conversion). Re-enable
# triggers + plan logged in next-session-tasks.md.
# NZ: never wired up. To be added post-validation.
#
# Caps are cumulative across markets via UTC-date filter in pipeline.py:
#   UK batch adds 5   → cap at 5      [paused — see above]
#   US batch adds 10  → cap at 15
#   AU batch adds 5   → cap at 20     [paused — see above]
#
# Volume-floor monitoring (added RMP #26, 2026-05-08):
#   Daily check at 14:00 CST = 06:00 UTC (1hr after US run completes). Fires SendGrid
#   alert if rolling 7-day US send volume drops below 50% of expected
#   (cap × days = 15 × 7 = 105 expected; floor = 52). Catches inventory
#   exhaustion, cascade failure, or silent cron failures earlier than
#   manual audit cadence (~9 days earlier per Apr 26 incident analysis).
#   Implementation: alert_on_failure.py --mode volume-floor
#
# MAILTO="" disables cron's default mail-on-output behavior.
# All alerts dispatched explicitly via alert_on_failure.py.
# Logs:
#   Per-market send runs: /var/log/rmp-cron/<market>-<YYYY-MM-DD>.log (via tee in run_market.sh)
#   Volume-floor checks:  /var/log/rmp-cron/volume-floor.log (rolling, no date)
#
# Rollback: comment out the three send lines and reinstall.
# Full removal: rm /etc/cron.d/rmp-pipeline on Tencent.
#
# File format: standard /etc/cron.d/ system cron (user field required between timing and command).
# Must be mode 644, owned by root, no extension. Cron ignores files otherwise.

MAILTO=""
PATH=/usr/local/bin:/usr/bin:/bin

# ─── Scanner (RMP #29, added 2026-05-11) ───────────────────────────
# Daily town discovery at 03:00 server local (10hr before US pipeline).
# Reads queue → Places API → writes scan_results_*.json to output/.
# Cost: ~$1.60/day. Queue burn: 1000 towns ÷ 10/day = 100 days.
# Activated 2026-05-13 (RMP #30) after pipeline confirmed pickup of
# smoke-test output scan_results_20260511_130651.json (2 sends on 2026-05-12).
0 3 * * * root cd /root/audit-scanner && set -a; . pipeline/.env; set +a; python3 scanner.py --queue --market us --batch-size 10 >> /var/log/rmp-cron/scanner-us.log 2>&1

# 0 8  * * * root /root/audit-scanner/pipeline/run_market.sh uk 5  >/dev/null 2>&1   # PAUSED 2026-05-08 RMP #26 — US-only focus
0 13 * * * root /root/audit-scanner/pipeline/run_market.sh us 15 >/dev/null 2>&1
# 0 22 * * * root /root/audit-scanner/pipeline/run_market.sh au 20 >/dev/null 2>&1   # PAUSED 2026-05-08 RMP #26 — US-only focus

# Volume-floor monitoring — daily check at 14:00 UTC (1hr post-US-run)
0 14 * * * root python3 /root/audit-scanner/pipeline/alert_on_failure.py --mode volume-floor --market us --cap 15 >>/var/log/rmp-cron/volume-floor.log 2>&1
